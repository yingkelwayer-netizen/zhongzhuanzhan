{
  "name": "personal-portal",
  "version": "1.0.0",
  "description": "A static personal portal website generated from JSON",
  "main": "build.js",
  "scripts": {
    "build": "node build.js",
    "test": "npm run test:parallax && npm run test:seo && npm run test:about && npm run test:deploy && npm run test:https-repair",
    "test:parallax": "node tests/parallax-structure.test.js",
    "test:seo": "node tests/seo-output.test.js",
    "test:about": "node tests/about-output.test.js",
    "test:deploy": "node tests/deploy-workflow.test.js",
    "test:https-repair": "node tests/https-repair-workflow.test.js",
    "watch:build": "nodemon --watch config.json --watch build.js --exec \"node build.js\"",
    "watch:serve": "live-server .",
    "dev": "concurrently \"npm run watch:build\" \"npm run watch:serve\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "live-server": "^1.2.2",
    "nodemon": "^3.0.3"
  }
}
